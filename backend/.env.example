# Workly Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Drive API v3 (OAuth 2.0 Credentials)
# Scope required: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REFRESH_TOKEN=1//your-google-oauth-refresh-token
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback

# Optional: Specific Root Folder ID in Google Drive (Leave blank to auto-create "Workly" root folder in My Drive)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
